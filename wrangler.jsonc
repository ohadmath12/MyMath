{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mythematix-registration",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "REGISTRATION_RATE_LIMITER",
      "namespace_id": "12092601",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "TURNSTILE_SITE_KEY",
      "TURNSTILE_SECRET",
      "TURNSTILE_EXPECTED_HOSTNAMES",
      "APPS_SCRIPT_URL",
      "APPS_SCRIPT_SHARED_SECRET"
    ]
  }
}
